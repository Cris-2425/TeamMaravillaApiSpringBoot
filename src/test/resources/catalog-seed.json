  "recipes": [
    {
      "id": 1,
      "title": "Tortilla de Patata",
      "imageUrl": null,
      "productIds": [
        "patata",
        "huevo",
        "cebolla",
        "aceite"
      ],
      "instructions": "1. Pela y corta las patatas en láminas finas.\n2. Fríe las patatas con la cebolla hasta que estén tiernas.\n3. Bate los huevos y mézclalos con las patatas escurridas.\n4. Cuaja la mezcla en una sartén por ambos lados."
    },
    {
      "id": 2,
      "title": "Ensalada Mixta",
      "imageUrl": null,
      "productIds": [
        "lechuga",
        "tomate",
        "cebolla",
        "aceitunas"
      ],
      "instructions": "1. Lava y corta todos los ingredientes.\n2. Mézclalos en un bol amplio.\n3. Aliña con aceite, vinagre y sal al gusto."
    },
    {
      "id": 3,
      "title": "Pasta al Pesto",
      "imageUrl": null,
      "productIds": [
        "pasta",
        "pesto",
        "queso"
      ],
      "instructions": "1. Cuece la pasta hasta que esté al dente.\n2. Mezcla la pasta caliente con el pesto.\n3. Añade queso rallado por encima antes de servir."
    },
    {
      "id": 4,
      "title": "Bizcocho Casero",
      "imageUrl": null,
      "productIds": [
        "harina",
        "huevo",
        "azucar",
        "leche"
      ],
      "instructions": "1. Mezcla todos los ingredientes en un bol.\n2. Vierte la mezcla en un molde engrasado.\n3. Hornea a 180ºC durante 35-40 minutos."
    },
    {
      "id": 5,
      "title": "Smoothie de Plátano y Mango",
      "imageUrl": null,
      "productIds": [
        "platano",
        "mango",
        "yogur"
      ],
      "instructions": "1. Pela el plátano y el mango.\n2. Mézclalos con el yogur en una batidora.\n3. Bate hasta obtener una textura homogénea."
    }
  ]
